// ============================================================================
// eFootball Kenya — Complete Relational PostgreSQL Schema (Section 28)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. USERS & AUTHENTICATION
// ----------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  phoneVerifiedAt   DateTime? @map("phone_verified_at")
  status            String    @default("ACTIVE") // ACTIVE, WARNED, SUSPENDED, BANNED, DELETED
  suspensionReason  String?   @map("suspension_reason")
  ageConfirmed      Boolean   @default(true) @map("age_confirmed")
  termsAcceptedAt   DateTime  @default(now()) @map("terms_accepted_at")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  profile                 Profile?
  accounts                Account[]
  sessions                Session[]
  platformIds             PlayerPlatformId[]
  roles                   UserRole[]
  preferences             UserPreference?
  notificationPreferences NotificationPreference?
  rating                  PlayerRating?
  ratingEvents            RatingEvent[]
  achievements            PlayerAchievement[]
  registrations           TournamentRegistration[]
  participations          TournamentParticipant[]
  organisedTournaments    Tournament[]             @relation("TournamentOrganiser")
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@index([status])
  @@map("users")
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  displayName   String   @map("display_name")
  county        String
  platform      String   // MOBILE, PLAYSTATION, XBOX, PC
  efootballId   String?  @map("efootball_id")
  bio           String?
  avatarUrl     String?  @map("avatar_url")
  isVerified    Boolean  @default(false) @map("is_verified")
  university    String?
  clanId        String?  @map("clan_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan Clan? @relation(fields: [clanId], references: [id], onDelete: SetNull)

  @@index([county])
  @@index([platform])
  @@map("profiles")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String   // google, credentials
  providerAccountId String   @map("provider_account_id")
  accessToken       String?  @map("access_token")
  refreshToken      String?  @map("refresh_token")
  expiresAt         Int?     @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  sessionToken String   @unique @map("session_token")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  purpose    String   @default("EMAIL_VERIFY") // EMAIL_VERIFY, PASSWORD_RESET
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("verification_tokens")
}

model PlayerPlatformId {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  platform   String   // MOBILE, PLAYSTATION, XBOX, PC
  handle     String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("player_platform_ids")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      String   // PLAYER, ORGANISER, MODERATOR, TOURNAMENT_ADMIN, FINANCE_ADMIN, CONTENT_EDITOR, SUPER_ADMIN
  grantedBy String?  @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  reducedMotion    Boolean  @default(false) @map("reduced_motion")
  allowChallenges  Boolean  @default(true) @map("allow_challenges")
  profilePublic    Boolean  @default(true) @map("profile_public")
  timezone         String   @default("Africa/Nairobi")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ----------------------------------------------------------------------------
// 2. TOURNAMENTS & MATCHES
// ----------------------------------------------------------------------------

model Tournament {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  description          String
  bannerUrl            String?   @map("banner_url")
  category             String    // DAILY_QUICK_CUP, WEEKEND_CUP, MONTHLY_KENYA_OPEN, COUNTY_CHAMPIONSHIP, UNIVERSITY_COMPETITION, CLAN_CHAMPIONSHIP, SPONSORED_EVENT, PRIVATE_TOURNAMENT
  format               String    // SINGLE_ELIMINATION, DOUBLE_ELIMINATION, ROUND_ROBIN, GROUP_PLUS_KNOCKOUT, LEAGUE_SEASON
  platform             String    // MOBILE, PLAYSTATION, XBOX, PC, CROSS_PLATFORM
  region               String    @default("National")
  status               String    @default("REGISTRATION_OPEN") // DRAFT, PUBLISHED, REGISTRATION_OPEN, REGISTRATION_CLOSED, IN_PROGRESS, COMPLETED, CANCELLED, ARCHIVED
  minParticipants      Int       @default(4) @map("min_participants")
  maxParticipants      Int       @default(16) @map("max_participants")
  registrationOpenAt   DateTime  @default(now()) @map("registration_open_at")
  registrationDeadline DateTime  @map("registration_deadline")
  startDate            DateTime  @map("start_date")
  entryRequirement     String    @default("Free Entry — Open to Verified Kenyan Players") @map("entry_requirement")
  prizeDetails         String?   @map("prize_details")
  sponsorName          String?   @map("sponsor_name")
  livestreamUrl        String?   @map("livestream_url")
  seedingMode          String    @default("SEEDED") @map("seeding_mode") // SEEDED, RANDOM
  isFeatured           Boolean   @default(false) @map("is_featured")
  organiserId          String    @map("organiser_id")
  winnerId             String?   @map("winner_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organiser     User                     @relation("TournamentOrganiser", fields: [organiserId], references: [id])
  rules         TournamentRule?
  registrations TournamentRegistration[]
  participants  TournamentParticipant[]
  groups        TournamentGroup[]
  rounds        TournamentRound[]
  brackets      TournamentBracket[]
  matches       TournamentMatch[]
  announcements TournamentAnnouncement[]

  @@index([status])
  @@index([category])
  @@index([platform])
  @@map("tournaments")
}

model TournamentRule {
  id                  String   @id @default(cuid())
  tournamentId        String   @unique @map("tournament_id")
  matchDurationMins   Int      @default(10) @map("match_duration_mins")
  extraTimeEnabled    Boolean  @default(true) @map("extra_time_enabled")
  penaltiesEnabled    Boolean  @default(true) @map("penalties_enabled")
  checkInWindowMins   Int      @default(15) @map("check_in_window_mins")
  gracePeriodMins     Int      @default(15) @map("grace_period_mins")
  resultDeadlineMins  Int      @default(60) @map("result_deadline_mins")
  rulesContent        String   @map("rules_content")
  disputePolicy       String   @map("dispute_policy")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_rules")
}

model TournamentRegistration {
  id           String    @id @default(cuid())
  tournamentId String    @map("tournament_id")
  userId       String    @map("user_id")
  status       String    @default("CONFIRMED") // CONFIRMED, WAITLISTED, WITHDRAWN, REJECTED
  registeredAt DateTime  @default(now()) @map("registered_at")
  withdrawnAt  DateTime? @map("withdrawn_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_registrations")
}

model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String   @map("tournament_id")
  userId       String   @map("user_id")
  seed         Int
  groupId      String?  @map("group_id")
  points       Int      @default(0)
  played       Int      @default(0)
  wins         Int      @default(0)
  draws        Int      @default(0)
  losses       Int      @default(0)
  goalsFor     Int      @default(0) @map("goals_for")
  goalsAgainst Int      @default(0) @map("goals_against")
  eliminated   Boolean  @default(false)

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

model TournamentGroup {
  id           String   @id @default(cuid())
  tournamentId String   @map("tournament_id")
  name         String   // Group A, Group B
  orderIndex   Int      @map("order_index")

  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participants TournamentParticipant[]
  matches      TournamentMatch[]

  @@map("tournament_groups")
}

model TournamentRound {
  id           String    @id @default(cuid())
  tournamentId String    @map("tournament_id")
  roundNumber  Int       @map("round_number")
  name         String    // Round of 16, Quarter-Finals, Semi-Finals, Final
  bracketSide  String    @default("WINNERS") @map("bracket_side") // WINNERS, LOSERS, GRAND_FINAL, GROUP, LEAGUE
  scheduledAt  DateTime? @map("scheduled_at")

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[]

  @@map("tournament_rounds")
}

model TournamentBracket {
  id           String   @id @default(cuid())
  tournamentId String   @map("tournament_id")
  bracketType  String   @default("MAIN") @map("bracket_type")
  metadataJson String   @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_brackets")
}

model TournamentMatch {
  id                String    @id @default(cuid())
  tournamentId      String?   @map("tournament_id")
  roundId           String?   @map("round_id")
  groupId           String?   @map("group_id")
  roundNumber       Int       @default(1) @map("round_number")
  roundLabel        String    @default("Round 1") @map("round_label")
  matchNumber       Int       @default(1) @map("match_number")
  bracketSide       String    @default("WINNERS") @map("bracket_side")
  playerOneId       String?   @map("player_one_id")
  playerTwoId       String?   @map("player_two_id")
  playerOneScore    Int?      @map("player_one_score")
  playerTwoScore    Int?      @map("player_two_score")
  winnerId          String?   @map("winner_id")
  nextMatchId       String?   @map("next_match_id")
  nextMatchSlot     Int?      @map("next_match_slot") // 1 or 2
  status            String    @default("SCHEDULED") // SCHEDULED, READY, IN_PROGRESS, AWAITING_RESULTS, AWAITING_CONFIRMATION, DISPUTED, COMPLETED, WALKOVER, CANCELLED
  scheduledAt       DateTime  @map("scheduled_at")
  reportingDeadline DateTime? @map("reporting_deadline")
  verifiedAt        DateTime? @map("verified_at")
  ratingProcessed   Boolean   @default(false) @map("rating_processed")
  isFriendly        Boolean   @default(false) @map("is_friendly")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tournament Tournament?       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round      TournamentRound?  @relation(fields: [roundId], references: [id], onDelete: SetNull)
  group      TournamentGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  results    MatchResult[]
  evidence   MatchEvidence[]
  checkins   MatchCheckin[]
  disputes   Dispute[]

  @@index([tournamentId, roundNumber])
  @@index([status])
  @@map("tournament_matches")
}

model MatchResult {
  id             String   @id @default(cuid())
  matchId        String   @map("match_id")
  submittedById  String   @map("submitted_by_id")
  playerOneScore Int      @map("player_one_score")
  playerTwoScore Int      @map("player_two_score")
  notes          String?
  status         String   @default("SUBMITTED") // SUBMITTED, CONFIRMED, CONFLICTED, OVERRIDDEN
  submittedAt    DateTime @default(now()) @map("submitted_at")

  match TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, submittedById])
  @@map("match_results")
}

model MatchEvidence {
  id           String   @id @default(cuid())
  matchId      String   @map("match_id")
  uploadedById String   @map("uploaded_by_id")
  fileType     String   @map("file_type") // IMAGE, VIDEO
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  storagePath  String   @map("storage_path")
  caption      String?
  isPrivate    Boolean  @default(true) @map("is_private")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  match TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_evidence")
}

model MatchCheckin {
  id          String   @id @default(cuid())
  matchId     String   @map("match_id")
  userId      String   @map("user_id")
  checkedInAt DateTime @default(now()) @map("checked_in_at")

  match TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@map("match_checkins")
}

model TournamentAnnouncement {
  id           String   @id @default(cuid())
  tournamentId String   @map("tournament_id")
  authorId     String   @map("author_id")
  title        String
  content      String
  createdAt    DateTime @default(now()) @map("created_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("tournament_announcements")
}

// ----------------------------------------------------------------------------
// 3. ELO RANKINGS, SEASONS & ACHIEVEMENTS
// ----------------------------------------------------------------------------

model PlayerRating {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  rating            Int      @default(1200)
  peakRating        Int      @default(1200) @map("peak_rating")
  lastRatingChange  Int      @default(0) @map("last_rating_change")
  matchesPlayed     Int      @default(0) @map("matches_played")
  wins              Int      @default(0)
  draws             Int      @default(0)
  losses            Int      @default(0)
  goalsScored       Int      @default(0) @map("goals_scored")
  goalsConceded     Int      @default(0) @map("goals_conceded")
  tournamentsPlayed Int      @default(0) @map("tournaments_played")
  tournamentsWon    Int      @default(0) @map("tournaments_won")
  currentStreak     Int      @default(0) @map("current_streak")
  bestStreak        Int      @default(0) @map("best_streak")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating(sort: Desc)])
  @@map("player_ratings")
}

model RatingEvent {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  matchId       String   @map("match_id")
  seasonId      String?  @map("season_id")
  oldRating     Int      @map("old_rating")
  newRating     Int      @map("new_rating")
  ratingDelta   Int      @map("rating_delta")
  kFactor       Int      @default(32) @map("k_factor")
  expectedScore Float    @map("expected_score")
  actualScore   Float    @map("actual_score")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@map("rating_events")
}

model RankingSeason {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  snapshots LeaderboardSnapshot[]

  @@map("ranking_seasons")
}

model LeaderboardSnapshot {
  id        String   @id @default(cuid())
  seasonId  String   @map("season_id")
  userId    String   @map("user_id")
  rank      Int
  rating    Int
  wins      Int
  matches   Int
  county    String
  platform  String
  createdAt DateTime @default(now()) @map("created_at")

  season RankingSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@map("leaderboard_snapshots")
}

model PlayerAchievement {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  code        String   // FIRST_WIN, FIVE_WINS, TEN_WINS, UNBEATEN_STREAK, TOURNAMENT_CHAMPION, COUNTY_CHAMPION, NATIONAL_CHALLENGER, CLAN_CHAMPION, SEASON_TOP_TEN
  title       String
  description String
  tier        String   @default("BLUE") // BLUE, YELLOW, SILVER, GOLD
  awardedAt   DateTime @default(now()) @map("awarded_at")
  sourceId    String?  @map("source_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("player_achievements")
}

// ----------------------------------------------------------------------------
// 4. CLANS & TEAMS
// ----------------------------------------------------------------------------

model Clan {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String   @unique
  slug        String   @unique
  description String
  county      String
  logoUrl     String?  @map("logo_url")
  founderId   String   @map("founder_id")
  rating      Int      @default(1200)
  wins        Int      @default(0)
  draws       Int      @default(0)
  losses      Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  profiles      Profile[]
  members       ClanMember[]
  invitations   ClanInvitation[]
  announcements ClanAnnouncement[]

  @@index([rating(sort: Desc)])
  @@map("clans")
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String   @map("clan_id")
  userId   String   @unique @map("user_id")
  role     String   @default("MEMBER") // OWNER, CAPTAIN, MEMBER
  status   String   @default("ACTIVE") // ACTIVE, PENDING_APPROVAL
  joinedAt DateTime @default(now()) @map("joined_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@map("clan_members")
}

model ClanInvitation {
  id          String   @id @default(cuid())
  clanId      String   @map("clan_id")
  invitedUser String   @map("invited_user")
  invitedBy   String   @map("invited_by")
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime @default(now()) @map("created_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@map("clan_invitations")
}

model ClanChallenge {
  id               String   @id @default(cuid())
  challengerClanId String   @map("challenger_clan_id")
  defenderClanId   String   @map("defender_clan_id")
  scheduledAt      DateTime @map("scheduled_at")
  status           String   @default("PENDING") // PENDING, ACCEPTED, COMPLETED, DECLINED
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("clan_challenges")
}

model ClanResult {
  id             String   @id @default(cuid())
  challengeId    String   @map("challenge_id")
  clanOneId      String   @map("clan_one_id")
  clanTwoId      String   @map("clan_two_id")
  clanOneScore   Int      @map("clan_one_score")
  clanTwoScore   Int      @map("clan_two_score")
  winnerClanId   String?  @map("winner_clan_id")
  verifiedAt     DateTime @default(now()) @map("verified_at")

  @@map("clan_results")
}

model ClanAnnouncement {
  id        String   @id @default(cuid())
  clanId    String   @map("clan_id")
  authorId  String   @map("author_id")
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@map("clan_announcements")
}

// ----------------------------------------------------------------------------
// 5. DISPUTES & MODERATION
// ----------------------------------------------------------------------------

model Dispute {
  id          String    @id @default(cuid())
  matchId     String    @map("match_id")
  openedById  String    @map("opened_by_id")
  category    String    // CONFLICTING_SCORES, NO_SHOW, SUSPECTED_CHEATING, RULE_VIOLATION, CONNECTION_PROBLEM, UNSPORTING_CONDUCT, OTHER
  description String
  status      String    @default("OPEN") // OPEN, UNDER_REVIEW, AWAITING_PROOF, RESOLVED, APPEALED, CLOSED
  assignedId  String?   @map("assigned_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  match     TournamentMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  evidence  DisputeEvidence[]
  messages  DisputeMessage[]
  decisions DisputeDecision[]
  appeals   DisputeAppeal[]

  @@index([status])
  @@map("disputes")
}

model DisputeEvidence {
  id           String   @id @default(cuid())
  disputeId    String   @map("dispute_id")
  uploadedById String   @map("uploaded_by_id")
  fileType     String   @map("file_type")
  storagePath  String   @map("storage_path")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_evidence")
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String   @map("dispute_id")
  senderId  String   @map("sender_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_messages")
}

model DisputeDecision {
  id             String   @id @default(cuid())
  disputeId      String   @map("dispute_id")
  moderatorId    String   @map("moderator_id")
  ruling         String   // CONFIRM_SCORE, ORDER_REMATCH, ISSUE_WALKOVER, APPLY_SANCTION, DISMISS
  playerOneScore Int?     @map("player_one_score")
  playerTwoScore Int?     @map("player_two_score")
  winnerId       String?  @map("winner_id")
  reasoning      String
  createdAt      DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_decisions")
}

model DisputeAppeal {
  id          String    @id @default(cuid())
  disputeId   String    @unique @map("dispute_id")
  appellantId String    @map("appellant_id")
  reason      String
  status      String    @default("PENDING") // PENDING, UPHELD, OVERTURNED
  reviewedBy  String?   @map("reviewed_by")
  reviewNotes String?   @map("review_notes")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@map("dispute_appeals")
}

// ----------------------------------------------------------------------------
// 6. COMMUNITY & FRIENDLY CHALLENGES
// ----------------------------------------------------------------------------

model PlayerFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@map("player_follows")
}

model PlayerBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("player_blocks")
}

model FriendlyChallenge {
  id           String    @id @default(cuid())
  challengerId String    @map("challenger_id")
  opponentId   String    @map("opponent_id")
  platform     String
  proposedTime DateTime  @map("proposed_time")
  message      String?
  status       String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED, CANCELLED
  matchId      String?   @map("match_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("friendly_challenges")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  eventType String   @map("event_type") // TOURNAMENT_RESULT, NEW_CHAMPION, ACHIEVEMENT, CLAN_MILESTONE, HIGHLIGHT, ANNOUNCEMENT
  title     String
  body      String
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")

  comments  Comment[]
  reactions Reaction[]

  @@map("activity_events")
}

model Comment {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  event ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Reaction {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  emoji     String   @default("FIRE") // FIRE, TROPHY, CLAP
  createdAt DateTime @default(now()) @map("created_at")

  event ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("reactions")
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String   @map("reporter_id")
  targetType  String   @map("target_type") // PLAYER, LISTING, COMMENT, CLAN
  targetId    String   @map("target_id")
  reason      String
  details     String?
  status      String   @default("OPEN") // OPEN, REVIEWED, ACTIONED, DISMISSED
  reviewedBy  String?  @map("reviewed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reports")
}

// ----------------------------------------------------------------------------
// 7. GAMING MARKETPLACE
// ----------------------------------------------------------------------------

model MarketplaceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  isPermitted Boolean  @default(true) @map("is_permitted")

  listings MarketplaceListing[]

  @@map("marketplace_categories")
}

model SellerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  displayName  String   @map("display_name")
  county       String
  isVerified   Boolean  @default(false) @map("is_verified")
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  ratingAvg    Float    @default(5.0) @map("rating_avg")
  totalSales   Int      @default(0) @map("total_sales")
  createdAt    DateTime @default(now()) @map("created_at")

  listings MarketplaceListing[]
  reviews  SellerReview[]

  @@map("seller_profiles")
}

model MarketplaceListing {
  id              String   @id @default(cuid())
  sellerId        String   @map("seller_id")
  categoryId      String   @map("category_id")
  title           String
  description     String
  priceKes        Int      @map("price_kes")
  fulfilmentTerms String   @map("fulfilment_terms")
  availability    String   @default("IN_STOCK") // IN_STOCK, BOOKING_OPEN, PAUSED, SOLD_OUT
  moderationState String   @default("APPROVED") @map("moderation_state") // PENDING_REVIEW, APPROVED, REJECTED, REMOVED
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  seller   SellerProfile       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category MarketplaceCategory @relation(fields: [categoryId], references: [id])
  images   ListingImage[]
  orders   MarketplaceOrder[]

  @@index([moderationState, availability])
  @@map("marketplace_listings")
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String @map("listing_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_images")
}

model MarketplaceOrder {
  id            String   @id @default(cuid())
  listingId     String   @map("listing_id")
  buyerId       String   @map("buyer_id")
  sellerId      String   @map("seller_id")
  amountKes     Int      @map("amount_kes")
  status        String   @default("PENDING") // PENDING, ACCEPTED, IN_PROGRESS, DELIVERED, CONFIRMED, CANCELLED, DISPUTED, REFUNDED
  buyerNotes    String?  @map("buyer_notes")
  deliveryNotes String?  @map("delivery_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listing  MarketplaceListing   @relation(fields: [listingId], references: [id])
  disputes MarketplaceDispute[]

  @@map("marketplace_orders")
}

model MarketplaceDispute {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  openedById  String    @map("opened_by_id")
  reason      String
  status      String    @default("OPEN") // OPEN, RESOLVED, REFUNDED
  resolution  String?
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("marketplace_disputes")
}

model SellerReview {
  id         String   @id @default(cuid())
  sellerId   String   @map("seller_id")
  reviewerId String   @map("reviewer_id")
  orderId    String   @unique @map("order_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_reviews")
}

// ----------------------------------------------------------------------------
// 8. FINANCE & M-PESA LEDGER INFRASTRUCTURE
// ----------------------------------------------------------------------------

model PaymentRequest {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @map("idempotency_key")
  userId         String   @map("user_id")
  provider       String   @default("MPESA_DARAJA") // MPESA_DARAJA, AIRTEL_MONEY
  purpose        String   // MARKETPLACE_ORDER, SPONSORSHIP, FUTURE_SUBSCRIPTION
  referenceId    String   @map("reference_id")
  phoneNumber    String   @map("phone_number")
  amountKes      Int      @map("amount_kes")
  status         String   @default("DISABLED_BY_COMPLIANCE") // DISABLED_BY_COMPLIANCE, PENDING, COMPLETED, FAILED, CANCELLED
  checkoutReqId  String?  @map("checkout_req_id")
  createdAt      DateTime @default(now()) @map("created_at")

  transactions PaymentTransaction[]

  @@map("payment_requests")
}

model PaymentTransaction {
  id               String   @id @default(cuid())
  paymentRequestId String   @map("payment_request_id")
  providerReceipt  String   @unique @map("provider_receipt")
  amountKes        Int      @map("amount_kes")
  rawCallbackJson  String   @map("raw_callback_json")
  verifiedAt       DateTime @default(now()) @map("verified_at")

  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id])

  @@map("payment_transactions")
}

model LedgerAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  accountType String   @map("account_type") // ASSET, LIABILITY, REVENUE, EXPENSE
  currency    String   @default("KES")
  balanceKes  Int      @default(0) @map("balance_kes")
  createdAt   DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String   @id @default(cuid())
  accountId     String   @map("account_id")
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id")
  direction     String   // DEBIT, CREDIT
  amountKes     Int      @map("amount_kes")
  description   String
  createdAt     DateTime @default(now()) @map("created_at")

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@map("ledger_entries")
}

model PayoutRequest {
  id          String   @id @default(cuid())
  recipientId String   @map("recipient_id")
  amountKes   Int      @map("amount_kes")
  status      String   @default("DISABLED_BY_COMPLIANCE")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("payout_requests")
}

model Refund {
  id               String   @id @default(cuid())
  paymentRequestId String   @map("payment_request_id")
  amountKes        Int      @map("amount_kes")
  reason           String
  status           String   @default("PENDING")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("refunds")
}

model Settlement {
  id          String   @id @default(cuid())
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  totalKes    Int      @map("total_kes")
  status      String   @default("RECONCILED")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("settlements")
}

model ReconciliationRecord {
  id             String   @id @default(cuid())
  statementDate  DateTime @map("statement_date")
  ledgerTotalKes Int      @map("ledger_total_kes")
  providerKes    Int      @map("provider_kes")
  discrepancyKes Int      @default(0) @map("discrepancy_kes")
  notes          String?
  reconciledBy   String   @map("reconciled_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("reconciliation_records")
}

// ----------------------------------------------------------------------------
// 9. CONTENT, LIVESTREAMS, NEWS & SPONSORS
// ----------------------------------------------------------------------------

model ArticleCategory {
  id   String @id @default(cuid())
  slug String @unique
  name String

  articles Article[]

  @@map("article_categories")
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  categoryId  String   @map("category_id")
  authorId    String   @map("author_id")
  coverUrl    String?  @map("cover_url")
  videoEmbed  String?  @map("video_embed")
  isHighlight Boolean  @default(false) @map("is_highlight")
  isPublished Boolean  @default(true) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at")

  category ArticleCategory @relation(fields: [categoryId], references: [id])

  @@map("articles")
}

model MediaAsset {
  id         String   @id @default(cuid())
  uploaderId String   @map("uploader_id")
  title      String
  url        String
  mimeType   String   @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("media_assets")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  ctaText   String   @map("cta_text")
  ctaUrl    String   @map("cta_url")
  placement String   @default("HOMEPAGE")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?  @map("logo_url")
  websiteUrl  String?  @map("website_url")
  tier        String   @default("OFFICIAL_PARTNER") // TITLE_SPONSOR, OFFICIAL_PARTNER, COMMUNITY_SUPPORTER
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  campaigns SponsorshipCampaign[]

  @@map("sponsors")
}

model SponsorshipCampaign {
  id          String   @id @default(cuid())
  sponsorId   String   @map("sponsor_id")
  title       String
  placement   String   // TOURNAMENT, HOMEPAGE_BANNER, CLAN, LIVESTREAM
  targetUrl   String   @map("target_url")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  status      String   @default("ACTIVE")

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@map("sponsorship_campaigns")
}

// ----------------------------------------------------------------------------
// 10. SYSTEM, NOTIFICATIONS, AUDIT LOGS & FEATURE FLAGS
// ----------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String    // TOURNAMENT_REGISTRATION, UPCOMING_MATCH, MATCH_SCHEDULE, RESULT_CONFIRMED, DISPUTE_UPDATE, RANKING_CHANGE, CLAN_INVITE, ANNOUNCEMENT, SECURITY
  title     String
  message   String
  linkUrl   String?   @map("link_url")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id          String  @id @default(cuid())
  userId      String  @unique @map("user_id")
  inApp       Boolean @default(true) @map("in_app")
  email       Boolean @default(true)
  sms         Boolean @default(false)
  webPush     Boolean @default(true) @map("web_push")
  matchAlerts Boolean @default(true) @map("match_alerts")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String
  compliance  String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}
