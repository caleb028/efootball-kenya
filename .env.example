# ============================================================================
# eFootball Kenya — Environment Variable Configuration Template
# Timezone: Africa/Nairobi | Currency: KES
# ============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="eFootball Kenya"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TIMEZONE="Africa/Nairobi"
NEXT_PUBLIC_CURRENCY="KES"

# Database
# Production PostgreSQL connection string (Prisma / Relational Engine)
DATABASE_URL="postgresql://postgres:password@localhost:5432/efootball_kenya?schema=public"
# Local SQLite database path for zero-config local execution and testing
SQLITE_DB_PATH="./data/efootball_kenya.db"

# Authentication & Security
JWT_SECRET="efootball-kenya-production-jwt-secret-replace-in-prod-2026"
SESSION_COOKIE_NAME="efk_session"
SESSION_MAX_AGE_SECONDS="604800"

# Google OAuth (Requires Google Cloud Console OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Email Delivery (SMTP / Resend — Required for production transactional emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@efootballkenya.co.ke"

# Optional SMS Verification (Africa's Talking / Twilio — Do NOT use fake OTP)
SMS_PROVIDER_ENABLED="false"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID="eFootballKE"

# Private Evidence & Media Storage (S3-Compatible Object Storage)
STORAGE_DRIVER="local" # "local" or "s3"
PRIVATE_EVIDENCE_DIR="./data/private_evidence"
S3_ENDPOINT=""
S3_BUCKET="efootball-kenya-evidence"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="af-south-1"

# Background Jobs (Redis + BullMQ)
REDIS_URL="redis://localhost:6379"

# ============================================================================
# COMPLIANCE & REGULATED FINANCIAL FEATURE FLAGS (MUST REMAIN FALSE UNTIL APPROVED)
# Per Section 18, 22, 32, and 35: Paid-entry tournaments, cash prizes, stored-value
# wallets, and subscription payments remain disabled until Kenyan legal/regulatory
# requirements and Safaricom Daraja / Airtel Money approvals are satisfied.
# ============================================================================
FEATURE_MPESA_PAYMENTS_ENABLED="false"
FEATURE_PAID_TOURNAMENTS_ENABLED="false"
FEATURE_CASH_PRIZES_ENABLED="false"
FEATURE_STORED_VALUE_WALLET_ENABLED="false"
FEATURE_PREMIUM_SUBSCRIPTIONS_ENABLED="false"

# Safaricom Daraja M-Pesa API (Inactive until FEATURE_MPESA_PAYMENTS_ENABLED="true")
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://efootballkenya.co.ke/api/finance/mpesa/callback"
MPESA_WEBHOOK_SECRET=""
